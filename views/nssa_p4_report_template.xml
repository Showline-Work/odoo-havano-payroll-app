<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nssa_p4_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="nssa" t-value="(data or {}).get('nssa', {})"/>
                        <t t-set="currency" t-value="run.company_id.currency_id"/>
                        <t t-set="currency_name" t-value="currency.name"/>

                        <div class="report-header">
                            <h2>NSSA P4 Contribution Report</h2>
                            <p class="report-subtitle">
                                Pay run: <span t-out="run.name"/> | Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                            </p>
                        </div>

                        <table class="summary-table">
                            <tr>
                                <td>
                                    <span class="summary-label">Employees</span>
                                    <span class="summary-value" t-out="len(nssa.get('employees', []))"/>
                                </td>
                                <td>
                                    <span class="summary-label">Total Insurable Earnings (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="nssa.get('totals', {}).get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Total Payment (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="nssa.get('totals', {}).get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Employer Payment (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="nssa.get('totals', {}).get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>

                        <table class="main-data-table">
                            <thead>
                                <tr>
                                    <th class="col-name">Surname</th>
                                    <th class="col-name">First Names</th>
                                    <th class="col-date">Start Date</th>
                                    <th class="col-date">End Date</th>
                                    <th class="col-amount">Total Insurable Earnings (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Current Contributions (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Arrears (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Prepayments (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Surcharge (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Total Payment (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Employer Payment (<span t-out="currency_name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="nssa.get('employees', [])" t-as="emp">
                                    <tr t-att-class="'row-even' if emp_index % 2 == 0 else 'row-odd'">
                                        <td class="col-name"><span t-out="emp.get('surname')"/></td>
                                        <td class="col-name"><span t-out="emp.get('first_names')"/></td>
                                        <td class="col-date"><span t-out="emp.get('start_date')"/></td>
                                        <td class="col-date"><span t-out="emp.get('end_date')"/></td>
                                        <td class="col-amount"><span t-out="emp.get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('current_contribution', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('arrears', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('prepayments', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('surcharge', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="grand-total">
                                    <td colspan="4">Grand Totals</td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('total_insurable_earnings', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('current_contribution', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('arrears', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('prepayments', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('surcharge', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('total_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-right"><span t-out="nssa.get('totals', {}).get('employer_payment', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_nssa_p4" model="ir.actions.report">
        <field name="name">NSSA P4 Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_nssa_p4_document</field>
        <field name="report_file">zimbabwe_payroll.report_nssa_p4_document</field>
        <field name="binding_model_id" ref="model_hr_payslip_run"/>
        <field name="binding_type">report</field>
    </record>
</odoo>