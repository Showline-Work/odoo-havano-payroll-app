<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimdef_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimdef" t-value="(data or {}).get('zimdef', {})"/>
                        <t t-set="currency" t-value="run.company_id.currency_id"/>
                        <t t-set="currency_name" t-value="currency.name"/>

                        <div class="report-header">
                            <h2>ZIMDEF Comprehensive Report</h2>
                            <p class="report-subtitle">
                                Pay run: <span t-out="run.name"/> | Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                            </p>
                        </div>

                        <table class="summary-table">
                            <tr>
                                <td>
                                    <span class="summary-label">Employees</span>
                                    <span class="summary-value" t-out="len(zimdef.get('employees', []))"/>
                                </td>
                                <td>
                                    <span class="summary-label">Basic salary total (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Employer ZIMDEF total (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Employer ZIMDEF on basic (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>

                        <table class="main-data-table">
                            <thead>
                                <tr>
                                    <th class="col-name">Surname</th>
                                    <th class="col-name">First Names</th>
                                    <th class="col-amount">Gross Wage (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">ZIMDEF on Gross (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Total ZIMDEF Payment (<span t-out="currency_name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimdef.get('employees', [])" t-as="emp">
                                    <tr t-att-class="'row-even' if emp_index % 2 == 0 else 'row-odd'">
                                        <td class="col-name"><span t-out="emp.get('surname')"/></td>
                                        <td class="col-name"><span t-out="emp.get('first_names')"/></td>
                                        <td class="col-amount"><span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('zimdef_employer')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('total_zimdef')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="grand-total">
                                    <td colspan="2">Grand Totals</td>
                                    <td class="col-amount"><span t-out="zimdef.get('totals', {}).get('basic', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="col-amount"><span t-out="zimdef.get('totals', {}).get('zimdef_employer', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="col-amount"><span t-out="zimdef.get('totals', {}).get('total_zimdef', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimdef" model="ir.actions.report">
        <field name="name">ZIMDEF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimdef_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimdef_document</field>
    </record>
</odoo>