<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_zimra_itf_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="run">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="company" t-value="run.company_id"/>
                        <t t-set="zimra" t-value="(data or {}).get('zimra', {})"/>
                        <t t-set="currency" t-value="run.company_id.currency_id"/>
                        <t t-set="currency_name" t-value="currency.name"/>

                        <div class="report-header">
                            <h2>ZIMRA ITF16 Report</h2>
                            <p class="report-subtitle">
                                Pay run: <span t-out="run.name"/> | Period: <span t-out="run.date_start"/> to <span t-out="run.date_end"/>
                            </p>
                        </div>

                        <table class="summary-table">
                            <tr>
                                <td>
                                    <span class="summary-label">Employees</span>
                                    <span class="summary-value" t-out="len(zimra.get('employees', []))"/>
                                </td>
                                <td>
                                    <span class="summary-label">Total gross pay (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimra.get('totals', {}).get('gross', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Total PAYE (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimra.get('totals', {}).get('paye', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                                <td>
                                    <span class="summary-label">Total tax due (<span t-out="currency_name"/>)</span>
                                    <span class="summary-value" t-out="zimra.get('totals', {}).get('total_tax_due', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </td>
                            </tr>
                        </table>

                        <table class="main-data-table">
                            <thead>
                                <tr>
                                    <th class="col-name">ID</th>
                                    <th class="col-name">Surname</th>
                                    <th class="col-name">First Name</th>
                                    <th class="col-amount">Basic Pension (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Gross Pay (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">PAYE (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">AIDS Levy (<span t-out="currency_name"/>)</th>
                                    <th class="col-amount">Total Tax (<span t-out="currency_name"/>)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="zimra.get('employees', [])" t-as="emp">
                                    <tr t-att-class="'row-even' if emp_index % 2 == 0 else 'row-odd'">
                                        <td class="col-name"><span t-out="emp.get('employee_id')"/></td>
                                        <td class="col-name"><span t-out="emp.get('surname')"/></td>
                                        <td class="col-name"><span t-out="emp.get('first_names')"/></td>
                                        <td class="col-amount"><span t-out="emp.get('basic')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('gross')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('paye')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('aids_levy')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                        <td class="col-amount"><span t-out="emp.get('total_tax_due')" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="grand-total">
                                    <td colspan="4">Totals</td>
                                    <td class="col-amount"><span t-out="zimra.get('totals', {}).get('gross', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="col-amount"><span t-out="zimra.get('totals', {}).get('paye', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="col-amount"><span t-out="zimra.get('totals', {}).get('aids_levy', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="col-amount"><span t-out="zimra.get('totals', {}).get('total_tax_due', 0)" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_zimra_itf" model="ir.actions.report">
        <field name="name">ZIMRA ITF Report</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zimbabwe_payroll.report_zimra_itf_document</field>
        <field name="report_file">zimbabwe_payroll.report_zimra_itf_document</field>
    </record>
</odoo>