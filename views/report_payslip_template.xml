<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_payslip" inherit_id="hr_payroll.report_payslip">
        <xpath expr="//h2[@id='payslip_name']" position="replace"/>
        <xpath expr="//div[@id='infos_table']" position="replace">
            <t t-set="currency" t-value="o.company_id.currency_id"/>
            <t t-set="currency_name" t-value="currency.name"/>
            <table class="summary-table">
                <tr>
                    <td>
                        <span class="summary-label">Employee</span>
                        <span class="summary-value" t-field="o.employee_id.name"/>
                    </td>
                    <td>
                        <span class="summary-label">Period</span>
                        <span class="summary-value"><span t-field="o.date_from"/> to <span t-field="o.date_to"/></span>
                    </td>
                    <td>
                        <span class="summary-label">Department</span>
                        <span class="summary-value" t-field="o.employee_id.department_id.name" default="N/A"/>
                    </td>
                    <td>
                        <span class="summary-label">Designation</span>
                        <span class="summary-value" t-field="o.employee_id.job_title" default="N/A"/>
                    </td>
                </tr>
            </table>
        </xpath>
        <xpath expr="//div[@id='payslip_lines_table']//thead//tr" position="replace">
            <tr>
                <th class="col-name">EARNINGS</th>
                <th class="col-amount">AMOUNT (<span t-out="currency_name"/>)</th>
                <th class="col-name">DEDUCTIONS</th>
                <th class="col-amount">AMOUNT (<span t-out="currency_name"/>)</th>
            </tr>
        </xpath>
        <xpath expr="//div[@id='to_pay']" position="replace"/>
    </template>
</odoo>